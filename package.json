{
	"name": "coffee-cli",
	"version": "0.0.0",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "prettier --check . && xo && tsc -p tsconfig.test.json && TSX_TSCONFIG_PATH=tsconfig.test.json ava",
		"ava": "TSX_TSCONFIG_PATH=tsconfig.test.json ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"ink": "^8.0.0",
		"meow": "^14.1.0",
		"react": "^19.3.1"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^9.0.0",
		"@sinonjs/fake-timers": "^15.4.0",
		"@types/figlet": "^1.12.0",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/sinonjs__fake-timers": "^15.0.1",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^8.4.0",
		"chalk": "^6.0.1",
		"eslint-config-xo-react": "^0.32.0",
		"figlet": "^1.12.0",
		"ink-testing-library": "^4.0.0",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	},
	"ava": {
		"files": [
			"test/**/*.test.ts",
			"test/**/*.test.tsx"
		],
		"extensions": [
			"ts",
			"tsx"
		],
		"nodeArguments": [
			"--import=tsx"
		],
		"timeout": "30s"
	},
	"prettier": "@vdemedes/prettier-config"
}
